                    <span className={day === 'Pon' ? 'text-red-500' : 'text-[#39ff14]'}>
                      {day}
                    </span>
                  </div>
                ))}
                
                {Array.from({ length: new Date(selectedYear, selectedMonth, 1).getDay() === 0 ? 6 : new Date(selectedYear, selectedMonth, 1).getDay() - 1 }).map((_, i) => (
                  <div key={`empty-${i}`} className="aspect-square bg-gray-900 rounded-lg p-2 opacity-50" />
                ))}

                {daysInMonth.map(date => {
                  const dateStr = date.toISOString().split('T')[0];
                  const daySessions = sessionsByDate[dateStr] || [];
                  const isMonday = date.getDay() === 1;

                  return (
                    <div
                      key={dateStr}
                      className={`aspect-square bg-gray-900 rounded-lg p-2 hover:border hover:border-[#39ff14] cursor-pointer ${isMonday ? 'border border-red-500' : ''}`}
                      onClick={() => {
                        if (!isMonday) {
                          setSelectedDate(dateStr);
                          setShowSessionForm(true);
                        }
                      }}
                    >
                      <span className={`text-sm ${isMonday ? 'text-red-500' : 'text-gray-400'}`}>
                        {date.getDate()}
                      </span>
                      {!isMonday && daySessions.map((s: any) => (
                        <div key={s.id} className="text-[10px] text-[#39ff14] truncate">
                          {s.time}
                        </div>
                      ))}
                    </div>
                  );
                })}
              </div>
            </div>

            {showSessionForm && (
              <SessionForm
                onCancel={() => {
                  setShowSessionForm(false);
                  setEditingSession(null);
                }}
              />
            )}
          </div>
        );

      case "statistika":
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-white">Statistika</h2>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <h3 className="text-lg font-semibold mb-4 text-white">Dnevni prihod</h3>
                <p className="text-3xl font-bold text-[#39ff14]">{revenue.daily.toFixed(2)}€</p>
              </div>
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <h3 className="text-lg font-semibold mb-4 text-white">Mesečni prihod</h3>
