    switch(activeMenu) {
      case "dashboard":
        return (
          <div className="space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <p className="text-gray-400 text-sm">Dnevni prihod</p>
                <p className="text-3xl font-bold mt-2 text-white">{revenue.daily.toFixed(2)}€</p>
              </div>
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <p className="text-gray-400 text-sm">Mesečni prihod</p>
                <p className="text-3xl font-bold mt-2 text-white">{revenue.monthly.toFixed(2)}€</p>
              </div>
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <p className="text-gray-400 text-sm">Dnevna popunjenost</p>
                <p className="text-3xl font-bold mt-2 text-white">{occupancy.daily}%</p>
              </div>
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <p className="text-gray-400 text-sm">Mesečna popunjenost</p>
                <p className="text-3xl font-bold mt-2 text-white">{occupancy.monthly}%</p>
