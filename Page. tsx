                <h3 className="text-lg font-semibold mb-4 text-white">Dnevna popunjenost</h3>
                <p className="text-3xl font-bold text-[#39ff14]">{occupancy.daily}%</p>
              </div>
              <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
                <h3 className="text-lg font-semibold mb-4 text-white">Mesečna popunjenost</h3>
                <p className="text-3xl font-bold text-[#39ff14]">{occupancy.monthly}%</p>
              </div>
            </div>
          </div>
        );

      case "arhiva":
        return (
          <div className="space-y-6">
            <div className="flex justify-between items-center">
              <h2 className="text-2xl font-bold text-white">Arhiva</h2>
              {archive.length > 0 && (
                <button
                  onClick={() => exportToPDF(archive, 'arhiva')}
                  className="bg-[#39ff14] text-black px-4 py-2 rounded-lg font-semibold hover:bg-opacity-80 flex items-center gap-2"
                >
                  <Download size={20} />
                  Izvezi
                </button>
              )}
            </div>

            <div className="bg-[#1a1a1a] rounded-xl border border-gray-800 overflow-hidden">
              <table className="w-full">
                <thead className="bg-gray-900">
                  <tr>
                    <th className="text-left p-4 text-[#39ff14]">Tip</th>
                    <th className="text-left p-4 text-[#39ff14]">Podaci</th>
                    <th className="text-left p-4 text-[#39ff14]">Datum</th>
                  </tr>
                </thead>
                <tbody>
                  {archive.map(record => (
                    <tr key={record.id} className="border-t border-gray-800">
                      <td className="p-4">
                        <span className="px-2 py-1 rounded-full text-xs bg-[#39ff14] bg-opacity-20 text-[#39ff14]">
                          {record.type}
                        </span>
                      </td>
                      <td className="p-4 text-gray-300">
                        {record.type === 'client' 
                          ? `${record.data.name} ${record.data.surname}`
                          : `${record.data.clientName} - ${record.data.date}`
                        }
                      </td>
                      <td className="p-4 text-gray-400">
                        {new Date(record.archivedAt).toLocaleDateString('sr-RS')}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );

      case "paketi":
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-white">Paketi</h2>
            
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {PACKAGES.map(paket => (
                <div key={paket.id} className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800 hover:border-[#39ff14]">
                  <h3 className="text-2xl font-bold mb-2 text-[#39ff14]">{paket.name}</h3>
                  <p className="text-4xl font-bold mb-4 text-white">-</p>
                  
                  <div className="space-y-4 mb-6 text-white">
                    <div className="flex items-center gap-2">
                      <CheckCircle size={18} className="text-[#39ff14]" />
                      <span>Broj termina: ___</span>
                    </div>
                    <div className="flex items-center gap-2">
                      <CheckCircle size={18} className="text-[#39ff14]" />
                      <span>Cena: ___ €</span>
                    </div>
                  </div>

                  <div className="border-t border-gray-800 pt-4">
                    <p className="text-sm text-gray-400">Aktivnih: {clients.filter(c => c.package === paket.id).length}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      default:
        return null;
    }
  };

  // ============================================
  // GLAVNI RENDER
  // ============================================

  return (
    <div className="min-h-screen bg-[#0a0a0a]">
      {passwordModalOpen && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800 max-w-sm w-full">
            <h3 className="text-xl font-bold mb-4 flex items-center gap-2 text-white">
              <Lock size={20} className="text-[#39ff14]" />
              Autorizacija
            </h3>
            <input
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="Lozinka"
              className="w-full bg-gray-900 border border-gray-800 rounded-lg px-4 py-2 mb-4 text-white"
              onKeyPress={(e) => e.key === 'Enter' && handlePasswordSubmit()}
            />
            <div className="flex gap-2">
              <button
                onClick={handlePasswordSubmit}
                className="flex-1 bg-[#39ff14] text-black px-4 py-2 rounded-lg font-semibold"
              >
                Potvrdi
              </button>
              <button
                onClick={() => setPasswordModalOpen(false)}
                className="flex-1 bg-gray-800 text-white px-4 py-2 rounded-lg font-semibold"
              >
                Otkaži
              </button>
            </div>
          </div>
        </div>
      )}

      <button
        onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
        className="lg:hidden fixed top-4 left-4 z-50 bg-[#1a1a1a] p-2 rounded-lg border border-gray-800"
      >
        {mobileMenuOpen ? <X size={24} className="text-[#39ff14]" /> : <Menu size={24} className="text-[#39ff14]" />}
      </button>

      <aside className={`
        fixed top-0 left-0 h-full w-64 bg-[#1a1a1a] border-r border-gray-800 z-40
        transition-transform duration-300 overflow-y-auto
        ${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'}
      `}>
        <div className="h-16 flex items-center justify-center border-b border-gray-800">
          <Dumbbell size={32} className="text-[#39ff14] mr-2" />
          <span className="text-xl font-bold">
            <span className="text-white">GYM</span>
            <span className="text-[#39ff14]">PRO</span>
          </span>
        </div>

        <nav className="p-4">
          {menuItems.map((item) => (
            <button
              key={item.id}
              onClick={() => {
                setActiveMenu(item.id);
                setMobileMenuOpen(false);
              }}
              className={`
                w-full flex items-center gap-3 px-4 py-3 rounded-lg mb-1
                transition-all hover:bg-gray-800 text-white
                ${activeMenu === item.id ? 'bg-[#39ff14] bg-opacity-10 text-[#39ff14] border-l-4 border-[#39ff14]' : 'text-gray-400'}
              `}
            >
              {item.icon}
              <span>{item.label}</span>
            </button>
          ))}
        </nav>

        <div className="p-4 border-t border-gray-800">
          <div className="text-xs text-gray-400 space-y-1">
            <p className="flex items-center gap-1">
              <Sun size={12} className="text-[#39ff14]" />
              <span>Utorak - Petak: 08-20h</span>
            </p>
            <p className="flex items-center gap-1">
              <Cloud size={12} className="text-[#39ff14]" />
              <span>Subota - Nedelja: 08-20h</span>
            </p>
            <p className="flex items-center gap-1">
              <Moon size={12} className="text-red-500" />
              <span>Ponedeljak: ZATVORENO</span>
            </p>
          </div>
        </div>
      </aside>

      <main className="lg:ml-64 p-4 lg:p-8">
        <header className="flex justify-between items-center mb-8">
          <h1 className="text-2xl lg:text-3xl font-bold text-white">
            {menuItems.find(i => i.id === activeMenu)?.label}
          </h1>

          <div className="flex items-center gap-4">
            {(activeMenu === 'clients' || activeMenu === 'arhiva') && (
              <div className="relative">
                <Search size={20} className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" />
                <input
                  type="text"
                  placeholder="Pretraži..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  className="bg-[#1a1a1a] border border-gray-800 rounded-lg pl-10 pr-4 py-2 text-white w-64"
                />
              </div>
            )}

            <div className="flex items-center gap-2 text-sm text-gray-400">
              <Save size={16} className="text-[#39ff14]" />
              <span className="hidden sm:inline">Auto-save</span>
            </div>

            <button className="relative p-2 bg-[#1a1a1a] rounded-lg border border-gray-800">
              <Bell size={20} className="text-gray-400" />
            </button>
          </div>
        </header>

        {renderContent()}
      </main>
    </div>
  );
}
