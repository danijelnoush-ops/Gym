              <div className="space-y-4">
                {Object.entries(revenue.byYear).map(([year, amount]) => (
                  <div key={year} className="flex items-center gap-4">
                    <span className="w-16 text-[#39ff14]">{year}.</span>
                    <div className="flex-1 h-4 bg-gray-800 rounded-full overflow-hidden">
                      <div 
                        className="h-full bg-[#39ff14] rounded-full"
                        style={{ width: `${(amount / Math.max(...Object.values(revenue.byYear))) * 100}%` }}
                      />
                    </div>
                    <span className="text-sm font-bold text-white">{amount.toFixed(2)}€</span>
                  </div>
                ))}
              </div>
            </div>

            <div className="bg-[#1a1a1a] p-6 rounded-xl border border-gray-800">
              <div className="flex items-center gap-4 flex-wrap text-white">
                <div className="flex items-center gap-2">
                  <Sun size={20} className="text-[#39ff14]" />
                  <span>Utorak - Petak: 08-20h</span>
                </div>
                <div className="flex items-center gap-2">
                  <Cloud size={20} className="text-[#39ff14]" />
                  <span>Subota - Nedelja: 08-20h</span>
                </div>
                <div className="flex items-center gap-2">
                  <Moon size={20} className="text-red-500" />
                  <span>Ponedeljak: ZATVORENO</span>
                </div>
              </div>
            </div>
          </div>
        );

      case "clients":
        const filteredClients = clients.filter(c => 
          `${c.name} ${c.surname} ${c.email}`.toLowerCase().includes(searchTerm.toLowerCase())
        );

        return (
          <div className="space-y-6">
            <div className="flex justify-between items-center">
              <h2 className="text-2xl font-bold text-white">Client list</h2>
              <button
                onClick={() => setShowClientForm(true)}
                className="bg-[#39ff14] text-black px-4 py-2 rounded-lg font-semibold hover:bg-opacity-80 flex items-center gap-2"
              >
                <UserPlus size={20} />
                Add Client
              </button>
            </div>

            {showClientForm && (
              <ClientForm
                client={editingClient || undefined}
                onSubmit={(data) => {
                  if (editingClient) {
                    handleUpdateClient({ ...editingClient, ...data });
                  } else {
                    handleAddClient(data);
                  }
                }}
                onCancel={() => {
                  setShowClientForm(false);
                  setEditingClient(null);
                }}
